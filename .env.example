# Copy this file to .env and fill in your own values.
#
#   cp .env.example .env        (macOS/Linux)
#   copy .env.example .env      (Windows)
#
# .env is already in .gitignore. Never commit a real key.
#
# Only ONE line below must change: the API key for whichever provider you
# choose. Everything else has a working default in src/config.py.
#
# The system also runs with NO key at all, in a degraded mode where its
# deterministic classifier and extractive generator do the work. Answers
# are more conservative, never absent. CI runs in exactly that mode.

# --- Which provider -------------------------------------------------------
# "openrouter" or "mistral". Both speak the same chat-completions API, so
# switching is a configuration change rather than a code change.
MODEL_PROVIDER=mistral

# --- Mistral (https://console.mistral.ai/) --------------------------------
# Used when MODEL_PROVIDER=mistral. A plain ~32-character string, no prefix.
MISTRAL_API_KEY=your_mistral_key_here
# Model names for this provider: mistral-small-latest, open-mistral-7b,
# mistral-medium-latest. mistral-small-latest is on the free tier and is
# more than adequate here.
MODEL_NAME=mistral-small-latest

# --- OpenRouter (https://openrouter.ai/) ----------------------------------
# Used when MODEL_PROVIDER=openrouter. Keys begin with sk-or-v1-.
# Leave the placeholder if you are using Mistral.
OPENROUTER_API_KEY=your_key_here
# If you switch MODEL_PROVIDER to openrouter, set MODEL_NAME above to an
# OpenRouter model id, for example:
#   meta-llama/llama-3.1-8b-instruct
#   mistralai/mistral-small-latest

# --- Embeddings -----------------------------------------------------------
# Retrieval is TF-IDF in pure Python and needs no embedding model. This is
# kept for reference only.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Storage --------------------------------------------------------------
# Relative paths resolve against the project root, so the store is written
# and read at the same absolute path whatever directory you launch from.
CHROMA_PATH=./storage/chroma
DATABASE_URL=sqlite:///./storage/decisions.db

# --- Pipeline behaviour ---------------------------------------------------
# Confidence at or above which the system may answer automatically.
# Derived from the development set: at this value no ticket that must
# never be auto-answered was auto-answered, on either the development or
# the held-out validation set.
CONFIDENCE_THRESHOLD=0.45

# Passages scoring below this are discarded. Returning nothing is a valid
# and often correct outcome.
RETRIEVAL_SCORE_THRESHOLD=0.12
RETRIEVAL_TOP_K=5

# --- Resilience -----------------------------------------------------------
# Free tiers throttle. Rate limiting is handled with exponential backoff
# and jitter rather than treated as a failure.
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=4
RETRY_BACKOFF_SECONDS=2

# Cache model responses on disk by request hash. Saves free-tier
# allowance, makes evaluation runs reproducible, and means a re-run after
# a crash does not pay again for work already done. Strongly recommended
# before running the full 580-ticket set.
CACHE_ENABLED=true
CACHE_PATH=./storage/model_cache

LOG_LEVEL=INFO
