# Copy this file to .env and fill in your own values.
# .env is already in .gitignore — never commit a real key.
#
#   cp .env.example .env
#
# Every value below has a working default in src/config.py, so the only
# line you must edit is the API key. The system runs without one, in a
# degraded mode where tickets needing a model opinion are escalated to a
# human instead — useful for offline development and for CI.

# --- Model access ---------------------------------------------------------
# Free tier is sufficient for this project. https://openrouter.ai/
OPENROUTER_API_KEY=your_key_here
MODEL_NAME=meta-llama/llama-3.1-8b-instruct
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Storage --------------------------------------------------------------
# Relative paths are resolved against the project root, so the vector store
# is written and read at the identical absolute path regardless of the
# directory the process was started from.
CHROMA_PATH=./storage/chroma
DATABASE_URL=sqlite:///./storage/decisions.db

# --- Pipeline behaviour ---------------------------------------------------
# Confidence at or above which the system may answer automatically.
# This shipped value is a starting point; the value actually used is
# derived from the development set and justified in the report.
CONFIDENCE_THRESHOLD=0.80

# Passages scoring below this are discarded rather than returned.
# Returning nothing is a valid and often correct outcome.
RETRIEVAL_SCORE_THRESHOLD=0.35
RETRIEVAL_TOP_K=5

# --- Resilience -----------------------------------------------------------
# Free tiers throttle. Rate limiting is handled with exponential backoff
# and jitter rather than treated as a failure.
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=4
RETRY_BACKOFF_SECONDS=2

# Cache model responses on disk by request hash. Saves free-tier
# allowance, makes evaluation runs reproducible, and means a re-run after
# a crash does not pay again for work already done.
CACHE_ENABLED=true
CACHE_PATH=./storage/model_cache

LOG_LEVEL=INFO
